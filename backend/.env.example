# Copiar a .env y completar. NUNCA versionar el .env con valores reales.
# Ver docs/SEGURIDAD.md §6 para la gestión de estos secretos.

SUPABASE_URL=https://xxxx.supabase.co

# Clave pública del proyecto. Va también en el front; no es una credencial de
# autorización (docs/SEGURIDAD.md §6.2).
SUPABASE_ANON_KEY=

# RESTRINGIDO — bypasea RLS por completo. Solo en el backend, jamás en el front
# ni en el repositorio. Rotación semestral.
SUPABASE_SERVICE_ROLE_KEY=

# CSV de orígenes permitidos por CORS.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
